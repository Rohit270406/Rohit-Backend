
PORT=8000
MONGODB_URI=mongodb+srv://<your_username>:<your_password>@cluster0.yourcluster.mongodb.net
# JWT Secrets(Generate using: node -e "console.log(require('crypto').randomBytes(64).toString
ACCESS_TOKEN_SECRET=your_access_token_secret_string_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_string_here
REFRESH_TOKEN_EXPIRY=10d